<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        Optional Pear logging example. It is intentionally not named logback-spring.xml,
        so adding the starter never overrides the host application's logging policy.
    -->
    <springProperty scope="context" name="LOG_LEVEL" source="pear.starter.log.level" defaultValue="INFO"/>
    <springProperty scope="context" name="LOG_PATTERN" source="pear.starter.log.stdout-pattern"
                    defaultValue="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n"/>

    <appender name="PEAR_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder charset="UTF-8">
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <logger name="cn.muzisheng.pear" level="${LOG_LEVEL}" additivity="true">
        <appender-ref ref="PEAR_STDOUT"/>
    </logger>
</configuration>
